{
  "name": "Electrolux Business Growth Hackathon",
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-python.python"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "command -v gcloud >/dev/null && command -v pdftotext >/dev/null || bash .devcontainer/setup.sh",
  "containerEnv": {
    "OPENROUTER_BASE_URL": "https://openrouter.ai/api/v1",
    "CLOUDSDK_CORE_PROJECT": "tohero-elx-hackathon"
  }
}
